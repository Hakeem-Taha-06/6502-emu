LOC   CODE         LABEL         INSTRUCTION

                   ; ------------------------------------------------------------------
                   ; NOT MADE BY ME  
                   ; CODE TAKEN FROM: https://gist.github.com/wkjagt/9043907
                   ; ALL COMMENTS BELOW ARE WRITTEN BY THE ORIGINAL AUTHOR
                   ; ------------------------------------------------------------------
                   ;  ___           _        __ ___  __ ___
                   ; / __|_ _  __ _| |_____ / /| __|/  \_  )
                   ; \__ \ ' \/ _` | / / -_) _ \__ \ () / /
                   ; |___/_||_\__,_|_\_\___\___/___/\__/___|
                   ; An annotated version of the snake example from Nick Morgan's 6502 assembly tutorial
                   ; on http://skilldrick.github.io/easy6502/ that I created as an exercise for myself
                   ; to learn a little bit about assembly. I **think** I understood everything, but I may
                   ; also be completely wrong :-)
                   ; Change direction with keys: W A S D
                   ; $00-01 => screen location of apple, stored as two bytes, where the first
                   ;           byte is the least significant.
                   ; $10-11 => screen location of snake head stored as two bytes
                   ; $12-?? => snake body (in byte pairs)
                   ; $02    => direction ; 1 => up    (bin 0001)
                   ; 2 => right (bin 0010)
                   ; 4 => down  (bin 0100)
                   ; 8 => left  (bin 1000)
                   ; $03    => snake length, in number of bytes, not segments
                   ;The screens is divided in 8 strips of 8x32 "pixels". Each strip
                   ;is stored in a page, having their own most significant byte. Each
                   ;page has 256 bytes, starting at $00 and ending at $ff.
                   ;   ------------------------------------------------------------
                   ;1  | $0200 - $02ff                                            |
                   ;2  |                                                          |
                   ;3  |                                                          |
                   ;4  |                                                          |
                   ;5  |                                                          |
                   ;6  |                                                          |
                   ;7  |                                                          |
                   ;8  |                                                          |
                   ;   ------------------------------------------------------------
                   ;9  | $03 - $03ff                                              |
                   ;10 |                                                          |
                   ;11 |                                                          |
                   ;12 |                                                          |
                   ;13 |                                                          |
                   ;14 |                                                          |
                   ;15 |                                                          |
                   ;16 |                                                          |
                   ;   ------------------------------------------------------------
                   ;17 | $04 - $03ff                                              |
                   ;18 |                                                          |
                   ;19 |                                                          |
                   ;20 |                                                          |
                   ;21 |                                                          |
                   ;22 |                                                          |
                   ;23 |                                                          |
                   ;24 |                                                          |
                   ;   ------------------------------------------------------------
                   ;25 | $05 - $03ff                                              |
                   ;26 |                                                          |
                   ;27 |                                                          |
                   ;28 |                                                          |
                   ;29 |                                                          |
                   ;30 |                                                          |
                   ;31 |                                                          |
                   ;32 |                                                          |
                   ;   ------------------------------------------------------------

0600                             * = $0600
0600  20 06 06                   JSR $0606 ;jump to subroutine init
0603  20 38 06                   JSR $0638 ;jump to subroutine loop
0606               INIT          
0606  20 0D 06                   JSR $060D ;jump to subroutine initSnake
0609  20 2A 06                   JSR $062A ;jump to subroutine generateApplePosition
060C  60                         RTS ;return
060D               INITSNAKE     
                                 ;start the snake in a horizontal position in the middle of the game field
                                 ;having a total length of one head and 4 bytes for the segments, meaning a
                                 ;total length of 3: the head and two segments.
                                 ;The head is looking right, and the snaking moving to the right.
                                 ;initial snake direction (2 => right)
060D  A9 02                      LDA #$02 ;start direction, put the dec number 2 in register A
060F  85 02                      STA $02 ;store value of register A at address $02
                                 ;initial snake length of 4
0611  A9 04                      LDA #$04 ;start length, put the dec number 4 (the snake is 4 bytes long)
                                 ;in register A
0613  85 03                      STA $03 ;store value of register A at address $03
                                 ;Initial snake head's location's least significant byte to determine
                                 ;where in a 8x32 strip the head will start. hex $11 is just right
                                 ;of the center of the first row of a strip
0615  A9 11                      LDA #$11 ;put the hex number $11 (dec 17) in register A
0617  85 10                      STA $10 ;store value of register A at address hex 10
                                 ;Initial snake body, two least significant bytes set to hex $10
                                 ;and hex $0f, one and two places left of the head respectively
0619  A9 10                      LDA #$10 ;put the hex number $10 (dec 16) in register A
061B  85 12                      STA $12 ;store value of register A at address hex $12
061D  A9 0F                      LDA #$0F ;put the hex number $0f (dec 15) in register A
061F  85 14                      STA $14 ;store value of register A at address hex $14
                                 ;the most significant bytes of the head and body of the snake
                                 ;are all set to hex $04, which is the third 8x32 strip.
0621  A9 04                      LDA #$04 ;put the hex number $04 in register A
0623  85 11                      STA $11 ;store value of register A at address hex 11
0625  85 13                      STA $13 ;store value of register A at address hex 13
0627  85 15                      STA $15 ;store value of register A at address hex 15
0629  60                         RTS ;return
062A               GENERATEAPPL  
                                 ;Th least significant byte of the apple position will determine where
                                 ;in a 8x32 strip the apple is placed. This number can be any one byte value because
                                 ;the size of one 8x32 strip fits exactly in one out of 256 bytes
062A  A5 FE                      LDA $FE ;load a random number between 0 and 255 from address $fe into register A
062C  85 00                      STA $00 ;store value of register A at address hex 00
                                 ;load a new random number from 2 to 5 into $01 for the most significant byte of
                                 ;the apple position. This will determine in which 8x32 strip the apple is placed
062E  A5 FE                      LDA $FE ;load a random number from address $fe into register A
                                 ;AND: logical AND with accumulator. Apply logical AND with hex $03 to value in
                                 ;register A. Hex 03 is binary 00000011, so only the two least significant bits
                                 ;are kept, resulting in a value between 0 (bin 00000000) and 3 (bin 00000011).
                                 ;Add 2 to the result, giving a random value between 2 and 5
0630  29 03                      AND #$03 ;mask out lowest 2 bits
0632  18                         CLC ;clear carry flag 
0633  69 02                      ADC #$02 ;add to register A, using carry bit for overflow.
0635  85 01                      STA $01 ;store value of y coordinate from register A into address $01
0637  60                         RTS ;return
0638               LOOP          
                                 ;the main game loop
0638  20 4D 06                   JSR $064D ;jump to subroutine readKeys
063B  20 8D 06                   JSR $068D ;jump to subroutine checkCollision
063E  20 C3 06                   JSR $06C3 ;jump to subroutine updateSnake
0641  20 19 07                   JSR $0719 ;jump to subroutine drawApple
0644  20 20 07                   JSR $0720 ;jump to subroutine drawSnake
0647  20 2D 07                   JSR $072D ;jump to subroutine spinWheels
064A  4C 38 06                   JMP $0638 ;jump to loop (this is what makes it loop)
064D               READKEYS      
                                 ;for getting keypresses, the last address ($ff) in the zero page contains
                                 ;the hex code of the last pressed key
064D  A5 FF                      LDA $FF ;load the value of the latest keypress from address $ff into register A
064F  C9 77                      CMP #$77 ;compare value in register A to hex $77 (W)
0651  F0 0D                      BEQ $0660 ;Branch On Equal, to upKey
0653  C9 64                      CMP #$64 ;compare value in register A to hex $64 (D)
0655  F0 14                      BEQ $066B ;Branch On Equal, to rightKey
0657  C9 73                      CMP #$73 ;compare value in register A to hex $73 (S)
0659  F0 1B                      BEQ $0676 ;Branch On Equal, to downKey
065B  C9 61                      CMP #$61 ;compare value in register A to hex $61 (A)
065D  F0 22                      BEQ $0681 ;Branch On Equal, to leftKey
065F  60                         RTS ;return
0660               UPKEY         
0660  A9 04                      LDA #$04 ;load value 4 into register A, correspoding to the value for DOWN
0662  24 02                      BIT $02 ;AND with value at address $02 (the current direction), 
                                 ;setting the zero flag if the result of ANDing the two values
                                 ;is 0. So comparing to 4 (bin 0100) only sets zero flag if
                                 ;current direction is 4 (DOWN). So for an illegal move (current
                                 ;direction is DOWN), the result of an AND would be a non zero value
                                 ;so the zero flag would not be set. For a legal move the bit in the
                                 ;new direction should not be the same as the one set for DOWN,
                                 ;so the zero flag needs to be set
0664  D0 26                      BNE $068C ;Branch If Not Equal: meaning the zero flag is not set.
0666  A9 01                      LDA #$01 ;Ending up here means the move is legal, load the value 1 (UP) into
                                 ;register A
0668  85 02                      STA $02 ;Store the value of A (the new direction) into register A
066A  60                         RTS ;return
066B               RIGHTKEY      
066B  A9 08                      LDA #$08 ;load value 8 into register A, corresponding to the value for LEFT
066D  24 02                      BIT $02 ;AND with current direction at address $02 and check if result
                                 ;is zero
066F  D0 1B                      BNE $068C ;Branch If Not Equal: meaning the zero flag is not set.
0671  A9 02                      LDA #$02 ;Ending up here means the move is legal, load the value 2 (RIGHT) into
                                 ;register A
0673  85 02                      STA $02 ;Store the value of A (the new direction) into register A
0675  60                         RTS ;return
0676               DOWNKEY       
0676  A9 01                      LDA #$01 ;load value 1 into register A, correspoding to the value for UP
0678  24 02                      BIT $02 ;AND with current direction at address $02 and check if result
                                 ;is zero
067A  D0 10                      BNE $068C ;Branch If Not Equal: meaning the zero flag is not set.
067C  A9 04                      LDA #$04 ;Ending up here means the move is legal, load the value 4 (DOWN) into
                                 ;register A
067E  85 02                      STA $02 ;Store the value of A (the new direction) into register A
0680  60                         RTS ;return
0681               LEFTKEY       
0681  A9 02                      LDA #$02 ;load value 1 into register A, correspoding to the value for RIGHT
0683  24 02                      BIT $02 ;AND with current direction at address $02 and check if result
                                 ;is zero
0685  D0 05                      BNE $068C ;Branch If Not Equal: meaning the zero flag is not set.
0687  A9 08                      LDA #$08 ;Ending up here means the move is legal, load the value 8 (LEFT) into
                                 ;register A
0689  85 02                      STA $02 ;Store the value of A (the new direction) into register A
068B  60                         RTS ;return
068C               ILLEGALMOVE   
                                 ;for an illegal move, just return, so the keypress is ignored
068C  60                         RTS ;return
068D               CHECKCOLLISI  
068D  20 94 06                   JSR $0694 ;jump to subroutine checkAppleCollision
0690  20 A8 06                   JSR $06A8 ;jump to subroutine checkSnakeCollision
0693  60                         RTS ;return
0694               CHECKAPPLECO  
                                 ;check if the snake collided with the apple by comparing the least significant
                                 ;and most significant byte of the position of the snake's head and the apple.
0694  A5 00                      LDA $00 ;load value at address $00 (the least significant
                                 ;byte of the apple's position) into register A
0696  C5 10                      CMP $10 ;compare to the value stored at address $10
                                 ;(the least significant byte of the position of the snake's head)
0698  D0 0D                      BNE $06A7 ;if different, branch to doneCheckingAppleCollision
069A  A5 01                      LDA $01 ;load value of address $01 (the most significant byte
                                 ;of the apple's position) into register A
069C  C5 11                      CMP $11 ;compare the value stored at address $11 (the most
                                 ;significant byte of the position of the snake's head)
069E  D0 07                      BNE $06A7 ;if different, branch to doneCheckingAppleCollision
                                 ;Ending up here means the coordinates of the snake head are equal to that of
                                 ;the apple: eat apple
06A0  E6 03                      INC $03 ;increment the value held in memory $03 (snake length)
06A2  E6 03                      INC $03 ;twice because we're adding two bytes for one segment
                                 ;create a new apple
06A4  20 2A 06                   JSR $062A ;jump to subroutine generateApplePosition
06A7               DONECHECKING  
                                 ;the snake head was not on the apple. Don't do anything with the apple
06A7  60                         RTS ;return
06A8               CHECKSNAKECO  
06A8  A2 02                      LDX #$02 ;Load the value 2 into the X register, so we start with the first segment
06AA               SNAKECOLLISI  
06AA  B5 10                      LDA $10,X ;load the value stored at address $10 (the least significant byte of
                                 ;the location of the snake's head) plus the value of the x register
                                 ;(2 in the first iteration) to get the least significant byte of the
                                 ;position of the next snake segment
06AC  C5 10                      CMP $10 ;compare to the value at address $10 (the least significant
                                 ;byte of the position of the snake's head
06AE  D0 06                      BNE $06B6 ;if not equals, we haven't found a collision yet,
                                 ;branch to continueCollisionLoop to continue the loop
06B0               MAYBECOLLIDE  
                                 ;ending up here means we found a segment of the snake's body that
                                 ;has a least significant byte that's equal to that of the snake's head.
06B0  B5 11                      LDA $11,X ;load the value stored at address $11 (most significant byte of
                                 ;the location of the snake's head) plus the value of the x register
                                 ;(2 in the first iteration) to get the most significant byte
                                 ;of the position of the next snake segment
06B2  C5 11                      CMP $11 ;compare to the value at address $11 (the most significant
                                 ;byte of the position of the snake head)
06B4  F0 09                      BEQ $06BF ;both position bytes of the compared segment of the snake body
                                 ;are equal to those of the head, so we have a collision of the
                                 ;snake's head with its own body.
06B6               CONTINUECOLL  
                                 ;increment the value in the x register twice because we use two bytes to store
                                 ;the coordinates for snake head and body segments
06B6  E8                         INX ;increment the value of the x register
06B7  E8                         INX ;increment the value of the x register
06B8  E4 03                      CPX $03 ;compare the value in the x register to the value stored at
                                 ;address $03 (snake length).
06BA  F0 06                      BEQ $06C2 ;if equals, we got to last section with no collision: branch
                                 ;to didntCollide
                                 ;ending up here means we haven't checked all snake body segments yet
06BC  4C AA 06                   JMP $06AA ;jump to snakeCollisionLoop to continue the loop
06BF               DIDCOLLIDE    
                                 ;there was a collision
06BF  4C 35 07                   JMP $0735 ;jump to gameOver
06C2               DIDNTCOLLIDE  
                                 ;there was no collision, continue the game
06C2  60                         RTS ;return
06C3               UPDATESNAKE   
                                 ;collision checks have been done, update the snake. Load the length of the snake
                                 ;minus one into the A register
06C3  A6 03                      LDX $03 ;load the value stored at address $03 (snake length) into register X
06C5  CA                         DEX ;decrement the value in the X register
06C6  8A                         TXA ;transfer the value stored in the X register into the A register. WHY?
06C7               UPDATELOOP    
                                 ;Example: the length of the snake is 4 bytes (two segments). In the lines above
                                 ;the X register has been set to 3. The snake coordinates are now stored as follows:
                                 ;$10,$11 : the snake head
                                 ;$12,$13,$14,$15: the snake body segments (two bytes for each of the 2 segments)
                                 ;
                                 ;The loop shifts all coordinates of the snake two places further in memory,
                                 ;calculating the offset of the origin from $10 and place it in memory offset to
                                 ;$12, effectively shifting each of the snake's segments one place further:
                                 ;
                                 ;from:  x===
                                 ;to:    ===
06C7  B5 10                      LDA $10,X ;load the value stored at address $10 + x into register A
06C9  95 12                      STA $12,X ;store the value of register A into address $12 
                                 ;plus the value of register X
06CB  CA                         DEX ;decrement X, and set negative flag if value becomes negative
06CC  10 F9                      BPL $06C7 ;branch to updateLoop if positive (negative flag not set)
                                 ;now determine where to move the head, based on the direction of the snake
                                 ;lsr: Logical Shift Right. Shift all bits in register A one bit to the right
                                 ;the bit that "falls off" is stored in the carry flag
06CE  A5 02                      LDA $02 ;load the value from address $02 (direction) into register A
06D0  4A                         LSR A ;shift to right
06D1  B0 09                      BCS $06DC ;if a 1 "fell off", we started with bin 0001, so the snakes needs to go up
06D3  4A                         LSR A ;shift to right
06D4  B0 19                      BCS $06EF ;if a 1 "fell off", we started with bin 0010, so the snakes needs to go right
06D6  4A                         LSR A ;shift to right
06D7  B0 1F                      BCS $06F8 ;if a 1 "fell off", we started with bin 0100, so the snakes needs to go down
06D9  4A                         LSR A ;shift to right
06DA  B0 2F                      BCS $070B ;if a 1 "fell off", we started with bin 1000, so the snakes needs to go left
06DC               UP            
06DC  A5 10                      LDA $10 ;put value stored at address $10 (the least significant byte, meaning the
                                 ;position in a 8x32 strip) in register A
06DE  38                         SEC ;set carry flag
06DF  E9 20                      SBC #$20 ;Subtract with Carry: subtract hex $20 (dec 32) together with the NOT of the
                                 ;carry bit from value in register A. If overflow occurs the carry bit is clear.
                                 ;This moves the snake up one row in its strip and checks for overflow
06E1  85 10                      STA $10 ;store value of register A at address $10 (the least significant byte
                                 ;of the head's position)
06E3  90 01                      BCC $06E6 ;If the carry flag is clear, we had an overflow because of the subtraction,
                                 ;so we need to move to the strip above the current one
06E5  60                         RTS ;return
06E6               UPUP          
                                 ;An overflow occurred when subtracting 20 from the least significant byte
06E6  C6 11                      DEC $11 ;decrement the most significant byte of the snake's head's position to
                                 ;move the snake's head to the next up 8x32 strip
06E8  A9 01                      LDA #$01 ;load hex value $1 (dec 1) into register A
06EA  C5 11                      CMP $11 ;compare the value at address $11 (snake head's most significant
                                 ;byte, determining which strip it's in). If it's 1, we're one strip too
                                 ;(the first one has a most significant byte of $02), which means the snake
                                 ;hit the top of the screen
06EC  F0 28                      BEQ $0716 ;branch if equal to collision
06EE  60                         RTS ;return
06EF               RIGHT         
06EF  E6 10                      INC $10 ;increment the value at address $10 (snake head's least
                                 ;significant byte, determining where in the 8x32 strip the head is
                                 ;located) to move the head to the right
06F1  A9 1F                      LDA #$1F ;load value hex $1f (dec 31) into register A
06F3  24 10                      BIT $10 ;the value stored at address $10 (the snake head coordinate) is ANDed
                                 ;with hex $1f (bin 11111), meaning all multiples of hex $20 (dec 32)
                                 ;will be zero (because they all end with bit patterns ending in 5 zeros)
                                 ;if it's zero, it means we hit the right of the screen
06F5  F0 1F                      BEQ $0716 ;branch to collision if zero flag is set
06F7  60                         RTS ;return
06F8               DOWN          
06F8  A5 10                      LDA $10 ;put value from address $10 (the least significant byte, meaning the
                                 ;position in a 8x32 strip) in register A
06FA  18                         CLC ;clear carry flag
06FB  69 20                      ADC #$20 ;add hex $20 (dec 32) to the value in register A and set the carry flag
                                 ;if overflow occurs
06FD  85 10                      STA $10 ;store the result at address $10 
06FF  B0 01                      BCS $0702 ;if the carry flag is set, an overflow occurred when adding hex $20 to the
                                 ;least significant byte of the location of the snake's head, so we need to move
                                 ;the next 8x3 strip
0701  60                         RTS ;return
0702               DOWNDOWN      
0702  E6 11                      INC $11 ;increment the value in location hex $11, holding the most significatnt byte
                                 ;of the location of the snake's head.
0704  A9 06                      LDA #$06 ;load the value hex $6 into the A register
0706  C5 11                      CMP $11 ;if the most significant byte of the head's location is equals to 6, we're
                                 ;one strip to far down (the last one was hex $05)
0708  F0 0C                      BEQ $0716 ;if equals to 6, the snake collided with the bottom of the screen
070A  60                         RTS ;return
070B               LEFT          
                                 ;A collision with the left side of the screen happens if the head wraps around to
                                 ;the previous row, on the right most side of the screen, where, because the screen
                                 ;is 32 wide, the right most positions always have a least significant byte that ends
                                 ;in 11111 in binary form (hex $1f). ANDing with hex $1f in this column will always
                                 ;return hex $1f, so comparing the result of the AND with hex $1f will determine if
                                 ;the snake collided with the left side of the screen.
070B  C6 10                      DEC $10 ;subtract one from the value held in memory position $10 (least significant
                                 ;byte of the snake head position) to make it move left.
070D  A5 10                      LDA $10 ;load value held in memory position $10 (least significant byte of the
                                 ;snake head position) into register A
070F  29 1F                      AND #$1F ;AND the value hex $1f (bin 11111) with the value in register A
0711  C9 1F                      CMP #$1F ;compare the ANDed value above with bin 11111.
0713  F0 01                      BEQ $0716 ;branch to collision if equals
0715  60                         RTS ;return
0716               COLLISION     
0716  4C 35 07                   JMP $0735 ;jump to gameOver
0719               DRAWAPPLE     
0719  A0 00                      LDY #$00 ;load the value 0 into the Y register
071B  A5 FE                      LDA $FE ;load the value stored at address $fe (the random number generator)
                                 ;into register A
071D  91 00                      STA ($00),Y ;dereference to the address stored at address $00 and $01
                                 ;(the address of the apple on the screen) and set the value to
                                 ;the value of register A and add the value of Y (0) to it. This results
                                 ;in the apple getting a random color
071F  60                         RTS ;return
0720               DRAWSNAKE     
0720  A2 00                      LDX #$00 ;set the value of the X register to 0
0722  A9 01                      LDA #$01 ;set the value of the A register to 1
0724  81 10                      STA ($10,X) ;dereference to the memory address that's stored at address
                                 ;$10 (the two bytes for the location of the head of the snake) and
                                 ;set its value to the one stored in register A
0726  A6 03                      LDX $03 ;set the value of the x register to the value stored in memory at
                                 ;location $03 (the length of the snake)
0728  A9 00                      LDA #$00 ;set the value of the a register to 0
072A  81 10                      STA ($10,X) ;dereference to the memory address that's stored at address
                                 ;$10, add the length of the snake to it, and store the value of
                                 ;register A (0) in the resulting address. This draws a black pixel on the
                                 ;tail. Because the snake is moving, the head "draws" on the screen in
                                 ;white as it moves, and the tail works as an eraser, erasing the white trail
                                 ;using black pixels
072C  60                         RTS ;return
072D               SPINWHEELS    
                                 ;slow the game down by wasting cycles
072D  A2 00                      LDX #$00 ;load zero in the X register
072F               SPINLOOP      
072F  EA                         NOP ;no operation, just skip a cycle
0730  EA                         NOP ;no operation, just skip a cycle
0731  CA                         DEX ;subtract one from the value stored in register x
0732  D0 FB                      BNE $072F ;if the zero flag is clear, loop. The first dex above wrapped the
                                 ;value of x to hex $ff, so the next zero value is 255 (hex $ff)
                                 ;loops later.
0734  60                         RTS ;return
0735               GAMEOVER      ;game over is literally the end of the program

done (code: 0600..0734).