  12               ; An annotated version of the snake example from Nick Morgan's 6502 assembly tutorial
  13               ; on http://skilldrick.github.io/easy6502/ that I created as an exercise for myself
  14               ; to learn a little bit about assembly. I **think** I understood everything, but I may
  15               ; also be completely wrong :-)
  17               ; Change direction with keys: W A S D
  19               ; $00-01 => screen location of apple, stored as two bytes, where the first
  20               ;           byte is the least significant.
  21               ; $10-11 => screen location of snake head stored as two bytes
  22               ; $12-?? => snake body (in byte pairs)
  23               ; $02    => direction ; 1 => up    (bin 0001)
  24               ; 2 => right (bin 0010)
  25               ; 4 => down  (bin 0100)
  26               ; 8 => left  (bin 1000)
  27               ; $03    => snake length, in number of bytes, not segments
  30               ;The screens is divided in 8 strips of 8x32 "pixels". Each strip
  31               ;is stored in a page, having their own most significant byte. Each
  32               ;page has 256 bytes, starting at $00 and ending at $ff.
  34               ;   ------------------------------------------------------------
  35               ;1  | $0200 - $02ff                                            |
  36               ;2  |                                                          |
  37               ;3  |                                                          |
  38               ;4  |                                                          |
  39               ;5  |                                                          |
  40               ;6  |                                                          |
  41               ;7  |                                                          |
  42               ;8  |                                                          |
  43               ;   ------------------------------------------------------------
  44               ;9  | $03 - $03ff                                              |
  45               ;10 |                                                          |
  46               ;11 |                                                          |
  47               ;12 |                                                          |
  48               ;13 |                                                          |
  49               ;14 |                                                          |
  50               ;15 |                                                          |
  51               ;16 |                                                          |
  52               ;   ------------------------------------------------------------
  53               ;17 | $04 - $03ff                                              |
  54               ;18 |                                                          |
  55               ;19 |                                                          |
  56               ;20 |                                                          |
  57               ;21 |                                                          |
  58               ;22 |                                                          |
  59               ;23 |                                                          |
  60               ;24 |                                                          |
  61               ;   ------------------------------------------------------------
  62               ;25 | $05 - $03ff                                              |
  63               ;26 |                                                          |
  64               ;27 |                                                          |
  65               ;28 |                                                          |
  66               ;29 |                                                          |
  67               ;30 |                                                          |
  68               ;31 |                                                          |
  69               ;32 |                                                          |
  70               ;   ------------------------------------------------------------

  71  0600                       * = $0600
  72  0600                       JSR INIT ;jump to subroutine init
  73  0603                       JSR LOOP ;jump to subroutine loop
  75  0606         INIT          
  76  0606                       JSR INITSNAKE ;jump to subroutine initSnake
  77  0609                       JSR GENERATEAPPL ;jump to subroutine generateApplePosition
  78  060C                       RTS ;return
  81  060D         INITSNAKE     
  82                             ;start the snake in a horizontal position in the middle of the game field
  83                             ;having a total length of one head and 4 bytes for the segments, meaning a
  84                             ;total length of 3: the head and two segments.
  85                             ;The head is looking right, and the snaking moving to the right.
  87                             ;initial snake direction (2 => right)
  88  060D                       LDA #2 ;start direction, put the dec number 2 in register A
  89  060F                       STA $02 ;store value of register A at address $02
  91                             ;initial snake length of 4
  92  0611                       LDA #4 ;start length, put the dec number 4 (the snake is 4 bytes long)
  93                             ;in register A
  94  0613                       STA $03 ;store value of register A at address $03
  96                             ;Initial snake head's location's least significant byte to determine
  97                             ;where in a 8x32 strip the head will start. hex $11 is just right
  98                             ;of the center of the first row of a strip
  99  0615                       LDA #$11 ;put the hex number $11 (dec 17) in register A
 100  0617                       STA $10 ;store value of register A at address hex 10
 102                             ;Initial snake body, two least significant bytes set to hex $10
 103                             ;and hex $0f, one and two places left of the head respectively
 104  0619                       LDA #$10 ;put the hex number $10 (dec 16) in register A
 105  061B                       STA $12 ;store value of register A at address hex $12
 106  061D                       LDA #$0F ;put the hex number $0f (dec 15) in register A
 107  061F                       STA $14 ;store value of register A at address hex $14
 109                             ;the most significant bytes of the head and body of the snake
 110                             ;are all set to hex $04, which is the third 8x32 strip.
 111  0621                       LDA #$04 ;put the hex number $04 in register A
 112  0623                       STA $11 ;store value of register A at address hex 11
 113  0625                       STA $13 ;store value of register A at address hex 13
 114  0627                       STA $15 ;store value of register A at address hex 15
 115  0629                       RTS ;return
 118  062A         GENERATEAPPL  
 119                             ;Th least significant byte of the apple position will determine where
 120                             ;in a 8x32 strip the apple is placed. This number can be any one byte value because
 121                             ;the size of one 8x32 strip fits exactly in one out of 256 bytes
 122  062A                       LDA $FE ;load a random number between 0 and 255 from address $fe into register A
 123  062C                       STA $00 ;store value of register A at address hex 00
 125                             ;load a new random number from 2 to 5 into $01 for the most significant byte of
 126                             ;the apple position. This will determine in which 8x32 strip the apple is placed
 127  062E                       LDA $FE ;load a random number from address $fe into register A
 129                             ;AND: logical AND with accumulator. Apply logical AND with hex $03 to value in
 130                             ;register A. Hex 03 is binary 00000011, so only the two least significant bits
 131                             ;are kept, resulting in a value between 0 (bin 00000000) and 3 (bin 00000011).
 132                             ;Add 2 to the result, giving a random value between 2 and 5
 133  0630                       AND #$03 ;mask out lowest 2 bits
 134  0632                       CLC ;clear carry flag 
 135  0633                       ADC #2 ;add to register A, using carry bit for overflow.
 136  0635                       STA $01 ;store value of y coordinate from register A into address $01
 138  0637                       RTS ;return
 141  0638         LOOP          
 142                             ;the main game loop
 143  0638                       JSR READKEYS ;jump to subroutine readKeys
 144  063B                       JSR CHECKCOLLISI ;jump to subroutine checkCollision
 145  063E                       JSR UPDATESNAKE ;jump to subroutine updateSnake
 146  0641                       JSR DRAWAPPLE ;jump to subroutine drawApple
 147  0644                       JSR DRAWSNAKE ;jump to subroutine drawSnake
 148  0647                       JSR SPINWHEELS ;jump to subroutine spinWheels
 149  064A                       JMP LOOP ;jump to loop (this is what makes it loop)
 152  064D         READKEYS      
 153                             ;for getting keypresses, the last address ($ff) in the zero page contains
 154                             ;the hex code of the last pressed key
 156  064D                       LDA $FF ;load the value of the latest keypress from address $ff into register A
 157  064F                       CMP #$77 ;compare value in register A to hex $77 (W)
 158  0651                       BEQ UPKEY ;Branch On Equal, to upKey
 159  0653                       CMP #$64 ;compare value in register A to hex $64 (D)
 160  0655                       BEQ RIGHTKEY ;Branch On Equal, to rightKey
 161  0657                       CMP #$73 ;compare value in register A to hex $73 (S)
 162  0659                       BEQ DOWNKEY ;Branch On Equal, to downKey
 163  065B                       CMP #$61 ;compare value in register A to hex $61 (A)
 164  065D                       BEQ LEFTKEY ;Branch On Equal, to leftKey
 165  065F                       RTS ;return
 167  0660         UPKEY         
 168  0660                       LDA #4 ;load value 4 into register A, correspoding to the value for DOWN
 169  0662                       BIT $02 ;AND with value at address $02 (the current direction), 
 170                             ;setting the zero flag if the result of ANDing the two values
 171                             ;is 0. So comparing to 4 (bin 0100) only sets zero flag if
 172                             ;current direction is 4 (DOWN). So for an illegal move (current
 173                             ;direction is DOWN), the result of an AND would be a non zero value
 174                             ;so the zero flag would not be set. For a legal move the bit in the
 175                             ;new direction should not be the same as the one set for DOWN,
 176                             ;so the zero flag needs to be set
 177  0664                       BNE ILLEGALMOVE ;Branch If Not Equal: meaning the zero flag is not set.
 179  0666                       LDA #1 ;Ending up here means the move is legal, load the value 1 (UP) into
 180                             ;register A
 181  0668                       STA $02 ;Store the value of A (the new direction) into register A
 182  066A                       RTS ;return
 184  066B         RIGHTKEY      
 185  066B                       LDA #8 ;load value 8 into register A, corresponding to the value for LEFT
 186  066D                       BIT $02 ;AND with current direction at address $02 and check if result
 187                             ;is zero
 188  066F                       BNE ILLEGALMOVE ;Branch If Not Equal: meaning the zero flag is not set.
 190  0671                       LDA #2 ;Ending up here means the move is legal, load the value 2 (RIGHT) into
 191                             ;register A
 192  0673                       STA $02 ;Store the value of A (the new direction) into register A
 193  0675                       RTS ;return
 195  0676         DOWNKEY       
 196  0676                       LDA #1 ;load value 1 into register A, correspoding to the value for UP
 197  0678                       BIT $02 ;AND with current direction at address $02 and check if result
 198                             ;is zero
 199  067A                       BNE ILLEGALMOVE ;Branch If Not Equal: meaning the zero flag is not set.
 201  067C                       LDA #4 ;Ending up here means the move is legal, load the value 4 (DOWN) into
 202                             ;register A
 203  067E                       STA $02 ;Store the value of A (the new direction) into register A
 204  0680                       RTS ;return
 206  0681         LEFTKEY       
 207  0681                       LDA #2 ;load value 1 into register A, correspoding to the value for RIGHT
 208  0683                       BIT $02 ;AND with current direction at address $02 and check if result
 209                             ;is zero
 210  0685                       BNE ILLEGALMOVE ;Branch If Not Equal: meaning the zero flag is not set.
 212  0687                       LDA #8 ;Ending up here means the move is legal, load the value 8 (LEFT) into
 213                             ;register A
 214  0689                       STA $02 ;Store the value of A (the new direction) into register A
 215  068B                       RTS ;return
 217  068C         ILLEGALMOVE   
 218                             ;for an illegal move, just return, so the keypress is ignored
 219  068C                       RTS ;return
 222  068D         CHECKCOLLISI  
 223  068D                       JSR CHECKAPPLECO ;jump to subroutine checkAppleCollision
 224  0690                       JSR CHECKSNAKECO ;jump to subroutine checkSnakeCollision
 225  0693                       RTS ;return
 228  0694         CHECKAPPLECO  
 229                             ;check if the snake collided with the apple by comparing the least significant
 230                             ;and most significant byte of the position of the snake's head and the apple.
 231  0694                       LDA $00 ;load value at address $00 (the least significant
 232                             ;byte of the apple's position) into register A
 233  0696                       CMP $10 ;compare to the value stored at address $10
 234                             ;(the least significant byte of the position of the snake's head)
 235  0698                       BNE DONECHECKING ;if different, branch to doneCheckingAppleCollision
 236  069A                       LDA $01 ;load value of address $01 (the most significant byte
 237                             ;of the apple's position) into register A
 238  069C                       CMP $11 ;compare the value stored at address $11 (the most
 239                             ;significant byte of the position of the snake's head)
 240  069E                       BNE DONECHECKING ;if different, branch to doneCheckingAppleCollision
 242                             ;Ending up here means the coordinates of the snake head are equal to that of
 243                             ;the apple: eat apple
 244  06A0                       INC $03 ;increment the value held in memory $03 (snake length)
 245  06A2                       INC $03 ;twice because we're adding two bytes for one segment
 247                             ;create a new apple
 248  06A4                       JSR GENERATEAPPL ;jump to subroutine generateApplePosition
 250  06A7         DONECHECKING  
 251                             ;the snake head was not on the apple. Don't do anything with the apple
 252  06A7                       RTS ;return
 255  06A8         CHECKSNAKECO  
 256  06A8                       LDX #2 ;Load the value 2 into the X register, so we start with the first segment
 258  06AA         SNAKECOLLISI  
 259  06AA                       LDA $10,X ;load the value stored at address $10 (the least significant byte of
 260                             ;the location of the snake's head) plus the value of the x register
 261                             ;(2 in the first iteration) to get the least significant byte of the
 262                             ;position of the next snake segment
 263  06AC                       CMP $10 ;compare to the value at address $10 (the least significant
 264                             ;byte of the position of the snake's head
 265  06AE                       BNE CONTINUECOLL ;if not equals, we haven't found a collision yet,
 266                             ;branch to continueCollisionLoop to continue the loop
 268  06B0         MAYBECOLLIDE  
 269                             ;ending up here means we found a segment of the snake's body that
 270                             ;has a least significant byte that's equal to that of the snake's head.
 271  06B0                       LDA $11,X ;load the value stored at address $11 (most significant byte of
 272                             ;the location of the snake's head) plus the value of the x register
 273                             ;(2 in the first iteration) to get the most significant byte
 274                             ;of the position of the next snake segment
 275  06B2                       CMP $11 ;compare to the value at address $11 (the most significant
 276                             ;byte of the position of the snake head)
 277  06B4                       BEQ DIDCOLLIDE ;both position bytes of the compared segment of the snake body
 278                             ;are equal to those of the head, so we have a collision of the
 279                             ;snake's head with its own body.
 281  06B6         CONTINUECOLL  
 282                             ;increment the value in the x register twice because we use two bytes to store
 283                             ;the coordinates for snake head and body segments
 284  06B6                       INX ;increment the value of the x register
 285  06B7                       INX ;increment the value of the x register
 286  06B8                       CPX $03 ;compare the value in the x register to the value stored at
 287                             ;address $03 (snake length).
 288  06BA                       BEQ DIDNTCOLLIDE ;if equals, we got to last section with no collision: branch
 289                             ;to didntCollide
 291                             ;ending up here means we haven't checked all snake body segments yet
 292  06BC                       JMP SNAKECOLLISI ;jump to snakeCollisionLoop to continue the loop
 294  06BF         DIDCOLLIDE    
 295                             ;there was a collision
 296  06BF                       JMP GAMEOVER ;jump to gameOver
 298  06C2         DIDNTCOLLIDE  
 299                             ;there was no collision, continue the game
 300  06C2                       RTS ;return
 303  06C3         UPDATESNAKE   
 304                             ;collision checks have been done, update the snake. Load the length of the snake
 305                             ;minus one into the A register
 306  06C3                       LDX $03 ;load the value stored at address $03 (snake length) into register X
 307  06C5                       DEX ;decrement the value in the X register
 308  06C6                       TXA ;transfer the value stored in the X register into the A register. WHY?
 310  06C7         UPDATELOOP    
 312                             ;Example: the length of the snake is 4 bytes (two segments). In the lines above
 313                             ;the X register has been set to 3. The snake coordinates are now stored as follows:
 314                             ;$10,$11 : the snake head
 315                             ;$12,$13,$14,$15: the snake body segments (two bytes for each of the 2 segments)
 316                             ;
 317                             ;The loop shifts all coordinates of the snake two places further in memory,
 318                             ;calculating the offset of the origin from $10 and place it in memory offset to
 319                             ;$12, effectively shifting each of the snake's segments one place further:
 320                             ;
 321                             ;from:  x===
 322                             ;to:    ===
 323  06C7                       LDA $10,X ;load the value stored at address $10 + x into register A
 324  06C9                       STA $12,X ;store the value of register A into address $12 
 325                             ;plus the value of register X
 326  06CB                       DEX ;decrement X, and set negative flag if value becomes negative
 327  06CC                       BPL UPDATELOOP ;branch to updateLoop if positive (negative flag not set)
 329                             ;now determine where to move the head, based on the direction of the snake
 330                             ;lsr: Logical Shift Right. Shift all bits in register A one bit to the right
 331                             ;the bit that "falls off" is stored in the carry flag
 332  06CE                       LDA $02 ;load the value from address $02 (direction) into register A
 333  06D0                       LSR ;shift to right
 334  06D1                       BCS UP ;if a 1 "fell off", we started with bin 0001, so the snakes needs to go up
 335  06D3                       LSR ;shift to right
 336  06D4                       BCS RIGHT ;if a 1 "fell off", we started with bin 0010, so the snakes needs to go right
 337  06D6                       LSR ;shift to right
 338  06D7                       BCS DOWN ;if a 1 "fell off", we started with bin 0100, so the snakes needs to go down
 339  06D9                       LSR ;shift to right
 340  06DA                       BCS LEFT ;if a 1 "fell off", we started with bin 1000, so the snakes needs to go left
 341  06DC         UP            
 342  06DC                       LDA $10 ;put value stored at address $10 (the least significant byte, meaning the
 343                             ;position in a 8x32 strip) in register A
 344  06DE                       SEC ;set carry flag
 345  06DF                       SBC #$20 ;Subtract with Carry: subtract hex $20 (dec 32) together with the NOT of the
 346                             ;carry bit from value in register A. If overflow occurs the carry bit is clear.
 347                             ;This moves the snake up one row in its strip and checks for overflow
 348  06E1                       STA $10 ;store value of register A at address $10 (the least significant byte
 349                             ;of the head's position)
 350  06E3                       BCC UPUP ;If the carry flag is clear, we had an overflow because of the subtraction,
 351                             ;so we need to move to the strip above the current one
 352  06E5                       RTS ;return
 353  06E6         UPUP          
 354                             ;An overflow occurred when subtracting 20 from the least significant byte
 355  06E6                       DEC $11 ;decrement the most significant byte of the snake's head's position to
 356                             ;move the snake's head to the next up 8x32 strip
 357  06E8                       LDA #$1 ;load hex value $1 (dec 1) into register A
 358  06EA                       CMP $11 ;compare the value at address $11 (snake head's most significant
 359                             ;byte, determining which strip it's in). If it's 1, we're one strip too
 360                             ;(the first one has a most significant byte of $02), which means the snake
 361                             ;hit the top of the screen
 363  06EC                       BEQ COLLISION ;branch if equal to collision
 364  06EE                       RTS ;return
 365  06EF         RIGHT         
 366  06EF                       INC $10 ;increment the value at address $10 (snake head's least
 367                             ;significant byte, determining where in the 8x32 strip the head is
 368                             ;located) to move the head to the right
 369  06F1                       LDA #$1F ;load value hex $1f (dec 31) into register A
 370  06F3                       BIT $10 ;the value stored at address $10 (the snake head coordinate) is ANDed
 371                             ;with hex $1f (bin 11111), meaning all multiples of hex $20 (dec 32)
 372                             ;will be zero (because they all end with bit patterns ending in 5 zeros)
 373                             ;if it's zero, it means we hit the right of the screen
 374  06F5                       BEQ COLLISION ;branch to collision if zero flag is set
 375  06F7                       RTS ;return
 376  06F8         DOWN          
 377  06F8                       LDA $10 ;put value from address $10 (the least significant byte, meaning the
 378                             ;position in a 8x32 strip) in register A
 379  06FA                       CLC ;clear carry flag
 380  06FB                       ADC #$20 ;add hex $20 (dec 32) to the value in register A and set the carry flag
 381                             ;if overflow occurs
 382  06FD                       STA $10 ;store the result at address $10 
 383  06FF                       BCS DOWNDOWN ;if the carry flag is set, an overflow occurred when adding hex $20 to the
 384                             ;least significant byte of the location of the snake's head, so we need to move
 385                             ;the next 8x3 strip
 386  0701                       RTS ;return
 387  0702         DOWNDOWN      
 388  0702                       INC $11 ;increment the value in location hex $11, holding the most significatnt byte
 389                             ;of the location of the snake's head.
 390  0704                       LDA #$6 ;load the value hex $6 into the A register
 391  0706                       CMP $11 ;if the most significant byte of the head's location is equals to 6, we're
 392                             ;one strip to far down (the last one was hex $05)
 393  0708                       BEQ COLLISION ;if equals to 6, the snake collided with the bottom of the screen
 394  070A                       RTS ;return
 396  070B         LEFT          
 397                             ;A collision with the left side of the screen happens if the head wraps around to
 398                             ;the previous row, on the right most side of the screen, where, because the screen
 399                             ;is 32 wide, the right most positions always have a least significant byte that ends
 400                             ;in 11111 in binary form (hex $1f). ANDing with hex $1f in this column will always
 401                             ;return hex $1f, so comparing the result of the AND with hex $1f will determine if
 402                             ;the snake collided with the left side of the screen.
 404  070B                       DEC $10 ;subtract one from the value held in memory position $10 (least significant
 405                             ;byte of the snake head position) to make it move left.
 406  070D                       LDA $10 ;load value held in memory position $10 (least significant byte of the
 407                             ;snake head position) into register A
 408  070F                       AND #$1F ;AND the value hex $1f (bin 11111) with the value in register A
 409  0711                       CMP #$1F ;compare the ANDed value above with bin 11111.
 410  0713                       BEQ COLLISION ;branch to collision if equals
 411  0715                       RTS ;return
 412  0716         COLLISION     
 413  0716                       JMP GAMEOVER ;jump to gameOver
 416  0719         DRAWAPPLE     
 417  0719                       LDY #0 ;load the value 0 into the Y register
 418  071B                       LDA $FE ;load the value stored at address $fe (the random number generator)
 419                             ;into register A
 420  071D                       STA ($00),Y ;dereference to the address stored at address $00 and $01
 421                             ;(the address of the apple on the screen) and set the value to
 422                             ;the value of register A and add the value of Y (0) to it. This results
 423                             ;in the apple getting a random color
 424  071F                       RTS ;return
 427  0720         DRAWSNAKE     
 428  0720                       LDX #0 ;set the value of the X register to 0
 429  0722                       LDA #1 ;set the value of the A register to 1
 430  0724                       STA ($10,X) ;dereference to the memory address that's stored at address
 431                             ;$10 (the two bytes for the location of the head of the snake) and
 432                             ;set its value to the one stored in register A
 433  0726                       LDX $03 ;set the value of the x register to the value stored in memory at
 434                             ;location $03 (the length of the snake)
 435  0728                       LDA #0 ;set the value of the a register to 0
 436  072A                       STA ($10,X) ;dereference to the memory address that's stored at address
 437                             ;$10, add the length of the snake to it, and store the value of
 438                             ;register A (0) in the resulting address. This draws a black pixel on the
 439                             ;tail. Because the snake is moving, the head "draws" on the screen in
 440                             ;white as it moves, and the tail works as an eraser, erasing the white trail
 441                             ;using black pixels
 442  072C                       RTS ;return
 445  072D         SPINWHEELS    
 446                             ;slow the game down by wasting cycles
 447  072D                       LDX #0 ;load zero in the X register
 448  072F         SPINLOOP      
 449  072F                       NOP ;no operation, just skip a cycle
 450  0730                       NOP ;no operation, just skip a cycle
 451  0731                       DEX ;subtract one from the value stored in register x
 452  0732                       BNE SPINLOOP ;if the zero flag is clear, loop. The first dex above wrapped the
 453                             ;value of x to hex $ff, so the next zero value is 255 (hex $ff)
 454                             ;loops later.
 455  0734                       RTS ;return
 458  0735         GAMEOVER      ;game over is literally the end of the program

